<Page x:Class="BedrockLauncher.Pages.Settings.Versions.VersionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:p="clr-namespace:BedrockLauncher.Properties"
      xmlns:classes="clr-namespace:BedrockLauncher.Classes"
      xmlns:viewModels="clr-namespace:BedrockLauncher.ViewModels"
      xmlns:converters="clr-namespace:JemExtensions.WPF.Converters;assembly=JemExtensions"
      xmlns:local="clr-namespace:BedrockLauncher"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=viewModels:MainDataModel}"
      d:DesignHeight="608" d:DesignWidth="828"
      Title="VersionsPage" x:Name="PageHost" Initialized="Page_Initialized" Loaded="PageHost_Loaded">
    <Page.Resources>
        <converters:InvertableBooleanToVisibilityConverter x:Key="VisibleIfTrueConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"></converters:InverseBooleanConverter>
        <CollectionViewSource x:Key="VersionsSource" Source="{Binding Path=Versions}" Filter="CollectionViewSource_Filter"></CollectionViewSource>
        <Style TargetType="{x:Type CheckBox}" x:Key="Checkbox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Foreground" Value="#FFCCCCCC"/>
            <Setter Property="FontFamily" Value="/BedrockLauncher;component/Resources/fonts/#Noto Sans"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="IsEnabled" Value="{Binding Source={x:Static viewModels:MainDataModel.Default}, Path=ProgressBarState.AllowEditing, Mode=OneWay}"/>
        </Style>
    </Page.Resources>
    <Grid Margin="0" Background="#FF1F1F1F" Style="{DynamicResource DisabledStyle}" IsEnabled="{Binding Source={x:Static viewModels:MainDataModel.Default}, Path=ProgressBarState.AllowEditing, Mode=OneWay}">
        <Grid.RowDefinitions>
            <RowDefinition Height="156"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Border BorderThickness="0,0,0,1" BorderBrush="#FF555555">
            <Grid ClipToBounds="True">
                <Grid.Background>
                    <ImageBrush ImageSource="/BedrockLauncher;component/Resources/images/bg/play_screen/1.21.130_mounts_of_mayhem.png"
                                Stretch="UniformToFill"
                                Opacity="0.32"
                                RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid.Background>
                <Rectangle Fill="#CC111111"/>
                <Grid Margin="24,18,24,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MINECRAFT FOR WINDOWS VERSIONS"
                                   Foreground="White"
                                   FontFamily="/BedrockLauncher;component/Resources/fonts/#Minecraft Ten"
                                   FontSize="28"
                                   TextOptions.TextHintingMode="Fixed"/>
                        <TextBlock Text="Install Store builds, keep older versions ready, and switch from the Play page."
                                   Foreground="#FFE6E6E6"
                                   FontFamily="/BedrockLauncher;component/Resources/fonts/#Noto Sans"
                                   FontSize="13"
                                   Margin="0,6,0,0"/>
                        <StackPanel HorizontalAlignment="Left" Height="35" VerticalAlignment="Top" Orientation="Horizontal" Margin="0,18,0,0">
                            <CheckBox Click="RefreshVersionsList" IsChecked="{Binding ShowReleases, Mode=TwoWay, Source={x:Static p:LauncherSettings.Default}, UpdateSourceTrigger=PropertyChanged}" Content="{DynamicResource ResourceKey=GeneralText_Releases}" Style="{StaticResource Checkbox}"></CheckBox>
                            <CheckBox Click="RefreshVersionsList" IsChecked="{Binding ShowBetas, Mode=TwoWay, Source={x:Static p:LauncherSettings.Default}, UpdateSourceTrigger=PropertyChanged}" Content="{DynamicResource ResourceKey=GeneralText_Betas}" Style="{StaticResource Checkbox}"></CheckBox>
                            <CheckBox Click="RefreshVersionsList" IsChecked="{Binding ShowPreviews, Mode=TwoWay, Source={x:Static p:LauncherSettings.Default}, UpdateSourceTrigger=PropertyChanged}" Content="{DynamicResource ResourceKey=GeneralText_Previews}" Style="{StaticResource Checkbox}"></CheckBox>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Button FontSize="14" HorizontalAlignment="Right" x:Name="RefreshButton" IsEnabled="{Binding IsVersionsUpdating, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}" Click="RefreshButton_Click" Content="{DynamicResource GeneralText_Refresh}" Style="{DynamicResource DialogButton_Green}" Height="34" MinWidth="122"/>
                        <Button FontSize="14" HorizontalAlignment="Right" x:Name="AddButton" IsEnabled="{Binding IsVersionsUpdating, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource InverseBooleanConverter}}" Click="AddButton_Click" Content="{DynamicResource VersionsPage_InstallVersion}" Style="{DynamicResource DialogButton}" Height="34" MinWidth="122" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <Border Grid.Row="1"
                Margin="18"
                Background="#FF282828"
                BorderBrush="#FF4A4A4A"
                BorderThickness="1">
            <ListView x:Name="VersionsList"
                      ItemsSource="{Binding Source={StaticResource VersionsSource}, IsAsync=True}"
                      SelectionMode="Single"
                      HorizontalContentAlignment="Stretch"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="8"
                      ItemTemplate="{StaticResource VersionItemTemplate}"/>
        </Border>
    </Grid>
</Page>
