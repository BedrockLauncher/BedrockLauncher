<UserControl x:Class="BedrockLauncher.Pages.Settings.Versions.Component_VersionItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:classes="clr-namespace:BedrockLauncher.Classes"
             xmlns:viewModels="clr-namespace:BedrockLauncher.ViewModels"
             xmlns:conv="clr-namespace:JemExtensions.WPF.Converters;assembly=JemExtensions"
             d:DataContext="{d:DesignInstance Type=classes:MCVersion}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InvertBoolean"/>
        <conv:BooleanAndConverter x:Key="BooleanAndConverter"/>
    </UserControl.Resources>
    <Border x:Name="InstallationEntry"
            Margin="0,6,0,6"
            Padding="16,12"
            Background="#FF343434"
            BorderBrush="#FF565656"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Border Width="54"
                    Height="54"
                    Background="#FF242424"
                    BorderBrush="#FF4D4D4D"
                    BorderThickness="1">
                <Image RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding IconPath}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="40" Height="40">
                <Image.OpacityMask>
                    <ImageBrush ImageSource="{Binding IconPath}"/>
                </Image.OpacityMask>
            </Image>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock FontSize="19" Foreground="{DynamicResource PrimaryText.Foreground}" FontWeight="DemiBold" FontFamily="/BedrockLauncher;component/Resources/fonts/#Noto Sans" Padding="0,0,0,0" Text="{Binding DisplayName}"/>
                <TextBlock FontSize="12" Foreground="#FFE6E6E6" Visibility="Visible" FontWeight="SemiBold" Padding="0,2,0,0" Text="{Binding VersionStatusText}"/>
                <TextBlock FontSize="9" Foreground="{DynamicResource TertiaryText.Foreground}" Visibility="Visible" FontWeight="SemiBold" Padding="0,3,0,0" Text="{Binding UUID}"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Grid.Column="2" x:Name="ButtonPanel" Visibility="Visible">
            <Button x:Name="Repair" Click="Repair_Click" Content="{Binding VersionActionText}" Style="{DynamicResource DialogButton_Orange}" MinWidth="86" Height="32">
                <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource BooleanAndConverter}">
                        <Binding Source="{x:Static viewModels:MainDataModel.Default}" Path="ProgressBarState.AllowEditing" Mode="OneWay"/>
                        <Binding Path="IsCustom" Converter="{StaticResource InvertBoolean}" Mode="OneWay"  />
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
            <Button x:Name="Folder" Click="Folder_Click" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" FontWeight="Bold" Style="{DynamicResource DialogButton}" IsEnabled="{Binding IsInstalledInLauncher}" Height="32">
                <Button.Content>
                    <Grid Width="16" Height="16">
                        <Path Stretch="Uniform" Fill="{DynamicResource OveralElements.Background}" StrokeThickness="0" Data="{DynamicResource FolderIcon}"/>
                    </Grid>
                </Button.Content>
            </Button>
            <Button x:Name="More" FontWeight="Bold" Style="{DynamicResource DialogButton}" Click="More_Click" IsEnabled="{Binding IsInstalledInLauncher}" Height="32">
                <Button.Content>
                    <Image Width="16" Height="16" Source="{DynamicResource Expandable}" Stretch="None"/>
                </Button.Content>
                <Button.ContextMenu>
                    <ContextMenu Closed="ContextMenu_Closed" Style="{DynamicResource NoCheckboxContextMenu}">
                        <MenuItem Header="{DynamicResource GeneralText_Remove}" IsEnabled="{Binding Source={x:Static viewModels:MainDataModel.Default}, Path=ProgressBarState.AllowEditing, Mode=OneWay}" Name="Remove" Click="Delete_Click"></MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </StackPanel>
        </Grid>
    </Border>
</UserControl>
