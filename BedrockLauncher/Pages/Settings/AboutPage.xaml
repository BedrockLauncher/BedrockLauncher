                            <TextBlock Text="mrmariix" FontSize="34" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock Text="Developer" FontSize="14" Foreground="#D8D8D8" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border x:Key="MetalManeMention">
            <Grid Background="Transparent" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition></RowDefinition>
                    <RowDefinition Height="40"></RowDefinition>
                </Grid.RowDefinitions>
                <Border Background="#262626" CornerRadius="10">
                    <Grid Height="150" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" HorizontalAlignment="Right" Source="/BedrockLauncher;component/resources/images/credits/MetalManeMc.jpg">
                            <Image.OpacityMask>
                                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#ffffffff" Offset="0.8" />
                                    <GradientStop Color="#00ffffff" Offset="0.9" />
                                </RadialGradientBrush>
                            </Image.OpacityMask>
