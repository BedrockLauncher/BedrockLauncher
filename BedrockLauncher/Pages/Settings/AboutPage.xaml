                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="220" Height="170" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="#555555" BorderThickness="1">
                            <Image Source="/BedrockLauncher;component/resources/images/credits/carjem_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Founder: Carjem Generations" FontWeight="Bold" FontSize="34" Foreground="White" FontFamily="/BedrockLauncher;component/#Noto Sans" TextWrapping="Wrap"/>
