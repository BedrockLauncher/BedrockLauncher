                                    <TextBlock Text="  " />
                                    <Button Style="{DynamicResource LinkButton}" Content="YouTube" Tag="{StaticResource Mrmariix_YoutubeURL}" Click="Button_Click" Padding="0" FontSize="13"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
