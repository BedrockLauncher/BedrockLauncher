                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="mrmariix" FontWeight="Bold" FontSize="24" Foreground="White" FontFamily="/BedrockLauncher;component/#Noto Sans" TextWrapping="Wrap"/>
