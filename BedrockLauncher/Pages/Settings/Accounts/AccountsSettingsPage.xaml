<Page x:Class="BedrockLauncher.Pages.Settings.Accounts.AccountsSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="828" d:DesignWidth="525"
      Title="AccountsSettingsPage"
      Loaded="Page_Loaded"
      MinWidth="728" MinHeight="525"
      Background="{DynamicResource Background.Secondary}">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="42,30,42,24">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Image Source="/BedrockLauncher;component/resources/images/credits/xbox_logo.png"
                           Height="32"
                           Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White">
                        <Run Text="XBOX" Foreground="#009461"/>
                        <Run Text=" INSIDER"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{DynamicResource AcountsSettingsPage_SelectedAccount_Subtitle}"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="White"
                           Margin="18,0,0,8"/>
                <ComboBox x:Name="AccountComboBox"
                          DisplayMemberPath="UserName"
                          Width="400"
                          Height="32"
                          HorizontalAlignment="Left"
                          Margin="18,0,0,14"
                          Padding="10,5,5,5"
                          FontSize="12"
                          SelectionChanged="AccountComboBox_SelectionChanged"/>

                <TextBlock Text="{DynamicResource AcountsSettingsPage_InsiderHub_Text}"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="White"
                           Margin="18,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="14,0,0,18">
                    <Button Content="{DynamicResource AcountsSettingsPage_InsiderHubNew_Text}"
                            Style="{DynamicResource DialogButton}"
                            Height="30"
                            Margin="0,0,8,0"
                            Click="XboxInsiderNew_Click"/>
                    <Button Content="{DynamicResource AcountsSettingsPage_InsiderHubLegacy_Text}"
                            Style="{DynamicResource DialogButton}"
                            Height="30"
                            Click="XboxInsiderLegacy_Click"/>
                </StackPanel>

                <Separator Margin="0,0,0,16"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Image Source="/BedrockLauncher;component/resources/images/credits/microsoft_logo.png"
                           Height="40"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Separator Background="White"
                               Height="30"
                               Margin="12,0"/>
                    <Image Source="/BedrockLauncher;component/resources/images/credits/mojang_logo.png"
                           Height="32"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </StackPanel>

                <TextBlock Text="{DynamicResource AcountsSettingsPage_AccountSettings_Text}"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="White"
                           Margin="16,0,0,5"/>
                <Button Content="{DynamicResource AcountsSettingsPage_ManageAccounts_Text}"
                        Style="{DynamicResource DialogButton}"
                        Height="30"
                        HorizontalAlignment="Left"
                        Margin="12,0,0,15"
                        Click="MSAccounts_Click"/>
                <Separator/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
