<Page x:Class="BedrockLauncher.Pages.FetchLatestVersion.FetchLatestVersionPageContent"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BedrockLauncher.Pages.FetchLatestVersion"
      xmlns:controls="clr-namespace:BedrockLauncher.Pages.General"
      xmlns:viewModels="clr-namespace:BedrockLauncher.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="WelcomePageOne" Width="596" Height="254">
    <Grid Margin="0" Background="{x:Null}">
        <Border Background="#FF313131" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,55" />
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Top" Text="{DynamicResource FetchLatestVersion_Title}" Foreground="White" FontFamily="/BedrockLauncher;component/Resources/fonts/#Noto Sans" FontSize="24" Margin="0,30,0,0" FontWeight="Bold"/>
        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" Text="{DynamicResource FetchLatestVersion_LoginInstructions}" VerticalAlignment="Top" Foreground="White" FontFamily="/BedrockLauncher;component/Resources/fonts/#Noto Sans" FontSize="14" Margin="28.5,87,28.5,0" TextWrapping="Wrap"/>

        <StackPanel Margin="0,130,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="LoginButton" Click="LoginButton_Click" SnapsToDevicePixels="True" Foreground="White" Style="{DynamicResource DialogButton_Green}" HorizontalAlignment="Center" VerticalAlignment="Top" Height="50" >
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/images/icons/ms-icon.png" Width="30px"></Image>
                    <TextBlock Margin="10,3,0,0" Text="{DynamicResource FetchLatestVersion_Login}" FontSize="24"></TextBlock>

                </StackPanel>
            </Button>
            <controls:General_LoaderIcon Width="0" Height="0" Margin="5,5,0,0" Visibility="{Binding Source={x:Static viewModels:MainDataModel.Default},Path=FetcherResult.ThinkingVisibility, Mode=OneWay}" VerticalAlignment="Top">
                <controls:General_LoaderIcon.RenderTransform>
                    <ScaleTransform ScaleX="0.4" ScaleY="0.4" />
                </controls:General_LoaderIcon.RenderTransform>
            </controls:General_LoaderIcon>
        </StackPanel>

        <StackPanel Margin="8,0,8,8" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <Button x:Name="CancelButton" Click="CancelButton_Click" SnapsToDevicePixels="True" Foreground="White" Style="{DynamicResource DialogButton}" Content="{DynamicResource GeneralText_Cancel}" HorizontalAlignment="Left" VerticalAlignment="Top" Height="32"/>
        </StackPanel>
        <StackPanel Margin="8,0,8,8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <Button x:Name="NextButton" Click="NextButton_Click" SnapsToDevicePixels="True" Foreground="White" Style="{DynamicResource DialogButton}" Content="{DynamicResource GeneralText_Next}" IsEnabled="{Binding Source={x:Static viewModels:MainDataModel.Default},Path=FetcherResult.IsDone, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="32"/>
        </StackPanel>
    </Grid>
</Page>
